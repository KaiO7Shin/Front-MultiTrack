{
  "name": "multitrack-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:admin",
    "dev:admin": "npm run dev --workspace @multitrack/admin",
    "dev:public": "npm run dev --workspace @multitrack/public",
    "dev:organizer": "npm run dev --workspace @multitrack/organizer",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm run build --workspace @multitrack/admin",
    "build:public": "npm run build --workspace @multitrack/public",
    "build:organizer": "npm run build --workspace @multitrack/organizer",
    "lint": "eslint .",
    "lint:admin": "npm run lint --workspace @multitrack/admin",
    "lint:public": "npm run lint --workspace @multitrack/public",
    "lint:organizer": "npm run lint --workspace @multitrack/organizer"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
